{
  "schema": "bnn_zoo_registry_v1",
  "thesis_note": "Entries are pedagogy / recipes — not SOTA claims. Compression ≠ wall-clock.",
  "models": [
    {
      "id": "binary_mlp_mnist",
      "name": "Binary MLP (MNIST)",
      "build": "bnn.models.build_model('binary_mlp')",
      "train_cli": "bnn train",
      "wrap": "hybrid_ffn / binary_xnor",
      "docs": ["docs/tutorials/01_GETTING_STARTED.md"],
      "results": ["results/mnist_ste.json"]
    },
    {
      "id": "bireal_cifar",
      "name": "Bi-Real CNN proxy (CIFAR-10)",
      "build": "bnn.vision / train-image",
      "train_cli": "bnn train-image",
      "wrap": "wrap_conv_modules",
      "docs": ["docs/tutorials/", "docs/imagenet_protocol.md"],
      "results": ["results/image_cifar.json"]
    },
    {
      "id": "resnet_bireal_cifar",
      "name": "ResNet-18 Bi-Real CIFAR reference (W4.T05)",
      "build": "bnn.vision.ResNetBiRealCIFAR",
      "train_cli": "bnn train-image --include-resnet",
      "wrap": "wrap_conv_modules (binary 3x3 path)",
      "docs": ["docs/imagenet_protocol.md", "docs/lanes/g.md"],
      "results": ["results/image_cifar.json"],
      "note": "Optional --include-resnet; floors remain binary_cifar_bireal (no new golden keys)"
    },
    {
      "id": "tiny_binary_vit",
      "name": "Tiny Binary ViT",
      "build": "bnn.vision",
      "train_cli": "bnn train-image --include-vit",
      "wrap": "hybrid_ffn on MLP blocks",
      "docs": ["docs/36_ENCODER_DECODER_AND_NEXT.md"],
      "results": []
    },
    {
      "id": "imagenet_protocol_smoke",
      "name": "ImageNet folder protocol runner (M6)",
      "build": "bnn.vision.ResNetBiReal18 / scripts/imagenet_protocol.py",
      "train_cli": "python scripts/imagenet_protocol.py --mode smoke",
      "wrap": "n/a (STE smoke)",
      "docs": ["docs/imagenet_protocol.md"],
      "results": ["results/imagenet_protocol_smoke.json"],
      "non_goal": "Full ImageNet SOTA train / CI gate"
    },
    {
      "id": "binary_transformer_seq2seq",
      "name": "Binary Transformer enc/dec (reverse task)",
      "build": "bnn.seq",
      "train_cli": "bnn train-seq2seq",
      "wrap": "bnn wrap-transformer",
      "docs": ["docs/tutorials/06_ENCODER_DECODER.md", "docs/36_ENCODER_DECODER_AND_NEXT.md"],
      "results": ["results/seq2seq_reverse.json"]
    },
    {
      "id": "audio_synthetic",
      "name": "Synthetic tone classifier",
      "build": "bnn.audio",
      "train_cli": "bnn train-audio",
      "wrap": "optional",
      "docs": ["docs/tutorials/"],
      "results": ["results/audio_tones.json"],
      "non_goal": "Not production ASR / Whisper"
    },
    {
      "id": "optimiser_tiny_block",
      "name": "Optimiser demo TinyBlock (FFN hybrid)",
      "build": "scripts/ultra_wrap_demo.py::TinyBlock",
      "train_cli": "bnn optimise",
      "wrap": "auto / hybrid_ffn / ternary_wo",
      "docs": ["docs/tutorials/07_OPTIMISER_QUICKSTART.md"],
      "results": ["results/ultra_wrap.json", "results/optimise_report.json"]
    }
  ]
}
