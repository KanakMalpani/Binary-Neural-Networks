    <node id="paper_gptq">
      <data key="label">GPTQ (Frantar et al., 2022)</data>
      <data key="type">Paper</data>
      <data key="summary">Second-order weight PTQ for LLM INT4; calib-domain sensitivity. Prefer with AWQ on GPU serve vs binary/ternary research paths.</data>
      <data key="confidence">0.95</data>
      <data key="status">literature</data>
      <data key="sources">https://arxiv.org/abs/2210.17323 | docs/24_GPU_INT4_FP8_LANE.md</data>
    </node>
    <node id="paper_qsparse">
      <data key="label">Q-Sparse (Wang et al., 2024)</data>
      <data key="type">Paper</data>
      <data key="summary">Activation sparsity for efficient LLMs (arXiv:2407.10969). Decision-tree neighbor to Sparse-BitNet / 2:4 sparsity — literature only; no local invented speedups.</data>
      <data key="confidence">0.85</data>
      <data key="status">literature</data>
      <data key="sources">https://arxiv.org/abs/2407.10969 | docs/02_SOTA_SURVEY.md</data>
    </node>
    <node id="result_energy_rapl_spike">
      <data key="label">RAPL Spike Result (Linux measure / Windows proxy)</data>
      <data key="type">Result</data>
      <data key="summary">Lane H PR #22: RAPL when powercap available; Windows CLOSED-BY-PROXY. Main tip still has latency energy_bound only — not a golden floor; do not invent board Joules.</data>
      <data key="confidence">0.85</data>
      <data key="status">open_pr</data>
      <data key="sources">results/energy_bound.json | docs/14_HARDWARE_AND_ENERGY.md | docs/MOONSHOT_DEFERRALS.md | https://github.com/KanakMalpani/Binary-Neural-Networks/pull/22</data>
    </node>
    <node id="decision_nongoal_asr_whisper">
      <data key="label">Non-goal: Production ASR / Whisper replacement</data>
      <data key="type">Decision</data>
      <data key="summary">Audio lane is packing/QAT pedagogy on features — not a production Whisper/ASR product. Prefer INT8 Whisper/ORT when ASR is the goal.</data>
      <data key="confidence">0.95</data>
      <data key="status">locked</data>
      <data key="sources">docs/28_IMAGE_AUDIO_COMPLETION.md | ROADMAP.md | docs/MOONSHOT_DEFERRALS.md</data>
    </node>
    <node id="decision_nongoal_memory_arena">
