    <node id="paper_bitdistiller">
      <data key="label">BitDistiller (Du et al., 2024)</data>
      <data key="type">Paper</data>
      <data key="summary">Sub-4-bit self-distillation arXiv:2402.10631 — distinct from BitNet Distillation (BitDistill, 2510.13998). Do not conflate names in lab docs.</data>
