  <graph id="bnn_kg" edgedefault="directed">
    <node id="thesis_lock">
      <data key="label">Thesis Lock: Packed CPU/edge XNOR + honest STE</data>
      <data key="type">Claim</data>
      <data key="summary">Speedups come from packed kernels on CPU/edge; never claim GPU 32× from sign(); compression 32× ≠ latency; STE trains latents, inference uses pack+popcount.</data>
      <data key="confidence">1.0</data>
      <data key="status">locked</data>
      <data key="sources">ROADMAP.md | AGENTS.md | docs/08_ADR.md | docs/05_PERFECTED_CONCEPT.md</data>
    </node>
    <node id="dual_metric_culture">
      <data key="label">Honest Dual-Metric Culture</data>
      <data key="type">Concept</data>
      <data key="summary">Always report theoretical word reduction / weight compression separately from measured wall-clock S_compute and S_e2e; never advertise 32×/64× as latency.</data>
      <data key="confidence">1.0</data>
      <data key="status">established</data>
      <data key="sources">docs/06_CALCULATED_SPEEDUP_MODEL.md | docs/FAIR_EVAL_PROTOCOL.md | results/SUMMARY.md</data>
    </node>
    <node id="bnn_lab_system">
      <data key="label">bnn-lab (Binary Neural Network Optimiser Lab)</data>
      <data key="type">System</data>
      <data key="summary">Installable PyTorch lab (v0.3.0): packed XNOR kernels, wrap/optimise, .bnnpack, vision/audio/seq lanes, repro gates, bridges to BitNet/GGUF/torchao.</data>
      <data key="confidence">1.0</data>
      <data key="status">established</data>
      <data key="sources">README.md | ROADMAP.md | pyproject.toml</data>
    </node>
    <node id="world_class_v1">
      <data key="label">World-Class Optimiser v1.0 Bar</data>
      <data key="type">Decision</data>
      <data key="summary">Acceptance gates WC-A/K/O/R/D/P in ROADMAP §1; until all pass, claim only lab/beta.</data>
      <data key="confidence">0.95</data>
      <data key="status">target</data>
      <data key="sources">ROADMAP.md#1-definition-of-world-class-acceptance-bar</data>
    </node>
    <node id="xnor_popcount_identity">
      <data key="label">XNOR–Popcount Dot-Product Identity</data>
      <data key="type">Concept</data>
      <data key="summary">For ±1 vectors with bit0↦+1, bit1↦−1: ⟨w,x⟩ = N − 2·popcount(w⊕x). Pad bits encode +1 so they do not inflate disagreement count.</data>
      <data key="confidence">1.0</data>
      <data key="status">established</data>
      <data key="sources">docs/01_FIRST_PRINCIPLES.md | docs/35_BINARY_MATH_EFFECTIVENESS.md | bnn/math/</data>
    </node>
    <node id="amdahl_law">
      <data key="label">Amdahl Bound on End-to-End Speedup</data>
      <data key="type">Concept</data>
      <data key="summary">S_e2e = 1/((1−f)+f/S_k). Non-binary layers (softmax, LN, attn, embed) cap e2e gains even when kernel S_k is large.</data>
      <data key="confidence">1.0</data>
      <data key="status">established</data>
      <data key="sources">docs/01_FIRST_PRINCIPLES.md | docs/06_CALCULATED_SPEEDUP_MODEL.md | results/SUMMARY.md</data>
    </node>
    <node id="bandwidth_bound">
      <data key="label">Memory-Bandwidth Bound Inference</data>
      <data key="type">Concept</data>
      <data key="summary">Large models / batch-1 decode often limited by DRAM bytes/s, not peak FLOPs. 32× denser weights can move kernels from DRAM-bound to L2/L3-bound.</data>
      <data key="confidence">0.95</data>
      <data key="status">established</data>
      <data key="sources">docs/01_FIRST_PRINCIPLES.md | docs/14_HARDWARE_AND_ENERGY.md</data>
    </node>
    <node id="compression_32x">
      <data key="label">Exact 32× Weight Compression (uint64 pack)</data>
      <data key="type">Metric</data>
      <data key="summary">Aligned binary pack: FP32 4 bytes → 1 bit = 32.00× exact. Gate in golden_floors.json.</data>
      <data key="confidence">1.0</data>
      <data key="status">established</data>
      <data key="sources">tests/golden_floors.json | results/benchmark.json | AGENTS.md</data>
    </node>
    <node id="theoretical_word_reduction_64x">
      <data key="label">Theoretical ~64× Word-Op Reduction</data>
      <data key="type">Metric</data>
      <data key="summary">64 binary MACs per uint64 XNOR+popcount vs scalar FP32 MAC counting — NOT a wall-clock claim.</data>
      <data key="confidence">1.0</data>
      <data key="status">established</data>
      <data key="sources">docs/06_CALCULATED_SPEEDUP_MODEL.md | results/benchmark.json</data>
    </node>
    <node id="energy_proxy_ept">
      <data key="label">Energy Proxy E = P · t</data>
      <data key="type">Metric</data>
      <data key="summary">Board Joules closed-by-proxy: measured wrap latency × assumed power brackets + lit anchors. RAPL optional on Linux; Windows stays proxy.</data>
      <data key="confidence">0.9</data>
      <data key="status">established</data>
      <data key="sources">results/energy_bound.json | docs/14_HARDWARE_AND_ENERGY.md | docs/spikes/RAPL_ENERGY_SPIKE.md</data>
    </node>
    <node id="fake_binary_sign">
      <data key="label">Fake Binary: sign() + FP GEMM</data>
      <data key="type">FailureMode</data>
      <data key="summary">PyTorch w.sign() @ x.sign() still uses FP32 GEMM — no packing → no speedup, often slowdown (extra sign kernels). Negative control in benches.</data>
      <data key="confidence">1.0</data>
      <data key="status">established</data>
      <data key="sources">docs/03_FAILURE_ANALYSIS.md | results/benchmark.json | docs/06_CALCULATED_SPEEDUP_MODEL.md</data>
    </node>
    <node id="accuracy_collapse">
      <data key="label">Accuracy Collapse from Information Loss</data>
      <data key="type">FailureMode</data>
      <data key="summary">sign destroys magnitude; deep binary stacks lose capacity (historically 10–20+ pp ImageNet).</data>
      <data key="confidence">0.95</data>
      <data key="status">established</data>
      <data key="sources">docs/03_FAILURE_ANALYSIS.md | docs/02_SOTA_SURVEY.md</data>
    </node>
    <node id="ste_mismatch">
      <data key="label">STE Gradient Mismatch</data>
      <data key="type">FailureMode</data>
      <data key="summary">True ∂sign/∂x = 0 a.e.; STE pretends identity on |x|≤1 → suboptimal minima risk.</data>
      <data key="confidence">0.95</data>
      <data key="status">established</data>
      <data key="sources">docs/03_FAILURE_ANALYSIS.md | docs/13_TRAINING_QAT_DISTILL.md | results/math_ste_compare.json</data>
    </node>
    <node id="gpu_tensor_core_reality">
      <data key="label">GPU Tensor Cores Beat Naive XNOR</data>
      <data key="type">FailureMode</data>
      <data key="summary">On A100/H100, FP16/BF16/FP8/INT8 Tensor Cores dominate; unoptimized binary popcount rarely beats cuDNN/cuBLAS end-to-end.</data>
      <data key="confidence">0.95</data>
      <data key="status">established</data>
      <data key="sources">docs/03_FAILURE_ANALYSIS.md | docs/14_HARDWARE_AND_ENERGY.md | arXiv:1911.04477</data>
    </node>
    <node id="first_last_layer_trap">
      <data key="label">Binarizing Stem/Head Trap</data>
      <data key="type">FailureMode</data>
      <data key="summary">Stem/head are small compute but critical for accuracy; always keep FP or ≥8-bit.</data>
      <data key="confidence">1.0</data>
      <data key="status">established</data>
      <data key="sources">docs/03_FAILURE_ANALYSIS.md | bnn/models.py</data>
    </node>
    <node id="ptq_ternary_llm_wipe">
      <data key="label">PTQ-Only Ternary LLM Quality Wipe</data>
      <data key="type">FailureMode</data>
      <data key="summary">Absmean-PTQ or direct QAT of chat Llama into {-1,0,1} without SubLN/CPT/distill is unstable; BitDistill shows gaps ~14 pp that **widen** with scale (0.6B→4B). Sub-4-bit PTQ (GPTQ/AWQ alone) also collapses quality. Use BitDistill recipe or train BitNet from scratch. Lab F13 / docs/23 already warn — cite 2510.13998 numbers.</data>
      <data key="confidence">0.93</data>
      <data key="status">merged</data>
      <data key="sources">docs/18_DECISION_TREE_AND_COMPLETE_ROADMAP.md | docs/12_WRAPPER_AND_EXISTING_MODELS.md | arXiv:2510.13998 | https://arxiv.org/abs/2510.13998 | docs/23_BITNET_CPP_BRIDGE.md | docs/17_EVALUATION_ROBUSTNESS_ECONOMICS.md</data>
    </node>
    <node id="npu_no_native_1bit">
      <data key="label">Stock NPU: No Native 1-bit</data>
      <data key="type">FailureMode</data>
      <data key="summary">Qualcomm HTP / Apple ANE / Arm Ethos-U are INT8/INT4/FP16-first; native XNOR not drop-in.</data>
      <data key="confidence">1.0</data>
      <data key="status">merged</data>
      <data key="sources">docs/20_NPU_VENDOR_CLOSURE.md | docs/14_HARDWARE_AND_ENERGY.md</data>
    </node>
    <node id="paper_bnn_2016">
      <data key="label">Binarized Neural Networks (Courbariaux et al. 2016)</data>
      <data key="type">Paper</data>
      <data key="summary">Foundational W+A ±1 with STE; GPU kernel demo era.</data>
      <data key="confidence">1.0</data>
      <data key="status">established</data>
      <data key="sources">arXiv:1602.02830 | docs/02_SOTA_SURVEY.md</data>
    </node>
    <node id="paper_xnornet">
      <data key="label">XNOR-Net (Rastegari et al. ECCV 2016)</data>
      <data key="type">Paper</data>
      <data key="summary">Channel-wise scaling α; claims ~58× faster conv ops and 32× memory on ImageNet AlexNet class.</data>
      <data key="confidence">1.0</data>
      <data key="status">established</data>
      <data key="sources">arXiv:1603.05279 | docs/02_SOTA_SURVEY.md</data>
    </node>
    <node id="paper_bireal">
      <data key="label">Bi-Real Net (Liu et al. ECCV 2018 / IJCV)</data>
      <data key="type">Paper</data>
      <data key="summary">1-bit CNN with full-precision identity shortcuts around every binary conv (≈2× real-valued paths vs BinaryNet). ApproxSign piecewise-polynomial STE. ImageNet ResNet-18: 56.4% top-1 / 79.5% top-5 (vs XNOR-Net 51.2% / BinaryNet 42.2% / FP ResNet-18 ~69.3%). ResNet-34: 62.2% top-1 / 83.9% top-5. Codes: github.com/liuzechun/Bi-Real-net. Lab uses Bi-Real residuals on MNIST/CIFAR proxies; full ImageNet train is ACCEPTED-NON-GOAL.</data>
      <data key="confidence">1.0</data>
      <data key="status">merged</data>
      <data key="sources">arXiv:1808.00278 | arXiv:1811.01335 | docs/02_SOTA_SURVEY.md | https://arxiv.org/abs/1808.00278 | https://arxiv.org/abs/1811.01335 | docs/03_FAILURE_ANALYSIS.md</data>
    </node>
    <node id="paper_reactnet">
      <data key="label">ReActNet (Liu et al. ECCV 2020)</data>
      <data key="type">Paper</data>
      <data key="summary">Generalizes Sign→RSign and PReLU→RPReLU (learnable channel-wise thresholds/slopes) + distributional KL loss vs real teacher. MobileNetV1-based ReActNet-A: **69.4%** ImageNet top-1 at **0.87×10^8 OPs** (~3.0 pp below real MobileNet twin 72.4%). ReActNet-B 70.1% @ 1.63e8 OPs; ReActNet-C 71.4% @ 2.14e8 OPs. ReAct on Bi-Real-18 → 65.5% (+9.1 pp). Comparison anchors: XNOR 51.2%, Bi-Real-18 56.4%, Real-to-Binary 65.4%, MeliusNet29 65.8%. Two-step training (acts then W+A). Code: github.com/liuzechun/ReActNet. Lab docs say '~71% claimed' — precise figures: A=69.4, C=71.4.</data>
      <data key="confidence">1.0</data>
      <data key="status">merged</data>
      <data key="sources">arXiv:2003.03488 | docs/02_SOTA_SURVEY.md | docs/13_TRAINING_QAT_DISTILL.md | https://arxiv.org/abs/2003.03488 | https://github.com/liuzechun/ReActNet</data>
    </node>
    <node id="paper_irnet">
      <data key="label">IR-Net (Qin et al. CVPR 2020)</data>
      <data key="type">Paper</data>
      <data key="summary">Information Retention Network; Error Decay Estimator (EDE) / tanh-soft STE schedule.</data>
      <data key="confidence">0.95</data>
      <data key="status">established</data>
      <data key="sources">arXiv:1909.10788 | docs/13_TRAINING_QAT_DISTILL.md | docs/35_BINARY_MATH_EFFECTIVENESS.md</data>
    </node>
    <node id="paper_xnornetpp">
      <data key="label">XNOR-Net++ (Bulat &amp; Tzimiropoulos BMVC 2019)</data>
      <data key="type">Paper</data>
      <data key="summary">Learned fused scale factors instead of analytic α; up to ~6% ImageNet gain vs XNOR-Net.</data>
      <data key="confidence">0.9</data>
      <data key="status">established</data>
      <data key="sources">arXiv:1909.13863 | docs/02_SOTA_SURVEY.md</data>
    </node>
    <node id="paper_bibert">
      <data key="label">BiBERT: Accurate Fully Binarized BERT (Qin et al. 2022)</data>
      <data key="type">Paper</data>
      <data key="summary">Qin et al. arXiv:2203.06390 — first accurate **W1 E1 A1** BERT. Failure diagnosis: (1) attention-weight information collapse under direct Sign; (2) distillation direction mismatch when using products of two binary activations. Fixes: **Bi-Attention** (maximize entropy of binary attention reps) + **Direction-Matching Distillation (DMD)**. Claims **56.3×** FLOPs and **31.2×** size savings; beats BinaryBERT W1A1 by ~20.4 pp avg GLUE and Q2BERT W2A8 by ~13.3 pp. Lab docs mention BiBERT briefly — strengthen with these failure modes and numbers.</data>
      <data key="confidence">0.95</data>
      <data key="status">merged</data>
      <data key="sources">arXiv:2203.06390 | docs/02_SOTA_SURVEY.md | https://arxiv.org/abs/2203.06390 | https://github.com/htqin/BiBERT | docs/13_TRAINING_QAT_DISTILL.md</data>
    </node>
    <node id="paper_bitnet">
      <data key="label">BitNet: Scaling 1-bit Transformers (Wang et al. 2023)</data>
      <data key="type">Paper</data>
      <data key="summary">Wang et al. replace nn.Linear with BitLinear (1-bit weights, higher-bit acts). Foundational proof that Transformers can train with extreme weight quantization. arXiv:2310.11453. Superseded for quality by ternary BitNet b1.58; keep distinction: original BitNet ≈ ±1, b1.58 adds 0.</data>
      <data key="confidence">1.0</data>
      <data key="status">merged</data>
      <data key="sources">arXiv:2310.11453 | docs/02_SOTA_SURVEY.md | https://arxiv.org/abs/2310.11453</data>
    </node>
    <node id="paper_bitnet_b158">
      <data key="label">BitNet b1.58 (Ma et al. 2024)</data>
      <data key="type">Paper</data>
      <data key="summary">Ternary {−1,0,1} weights; matches FP16 LLaMA-class from ~3B+ at equal tokens; memory ~3.55×, latency ~2.71× at 3B; 0 enables feature gating.</data>
      <data key="confidence">1.0</data>
      <data key="status">merged</data>
      <data key="sources">arXiv:2402.17764 | docs/02_SOTA_SURVEY.md | docs/01_FIRST_PRINCIPLES.md | https://arxiv.org/abs/2402.17764 | docs/14_HARDWARE_AND_ENERGY.md</data>
    </node>
    <node id="paper_bitnet_cpp">
      <data key="label">1-bit AI Infra / bitnet.cpp (Wang et al. 2024)</data>
      <data key="type">Paper</data>
      <data key="summary">Wang et al. arXiv:2410.16144 — ternary CPU kernels (TL1/TL2) vs llama.cpp FP16. **Cite carefully with device+thread context:** Apple M2 Ultra unlimited threads: speedup **1.37×–5.07×** (125M→70B); Intel i7-13700H: **2.37×–6.17×**. Energy J/token savings: M2 **55.4%/64.6%/70.0%** (700M/7B/70B); i7 **71.9%/82.2%** (700M/7B). 100B ternary on M2 ~6.58 tok/s unlimited (human-reading class). Lossless vs FP32 kernel on WildChat token match (TL1/TL2 100% vs TQ1_0 1.4%). ACL follow-up arXiv:2502.11880. Official HF: microsoft/bitnet-b1.58-2B-4T (+gguf). Lab docs cite ranges correctly; add hardware footnotes + J/token table.</data>
      <data key="confidence">1.0</data>
      <data key="status">merged</data>
      <data key="sources">arXiv:2410.16144 | docs/23_BITNET_CPP_BRIDGE.md | docs/02_SOTA_SURVEY.md | https://arxiv.org/abs/2410.16144 | https://arxiv.org/abs/2502.11880 | https://github.com/microsoft/BitNet | https://hf.co/microsoft/bitnet-b1.58-2B-4T</data>
    </node>
    <node id="paper_bitnet_a48">
      <data key="label">BitNet a4.8 (Wang et al. 2024)</data>
      <data key="type">Paper</data>
      <data key="summary">Wang/Ma/Wei hybrid: INT4 (or FP4) activations into attention/FFN inputs; TopK sparsify + INT8 on intermediate states (attn out-proj, FFN down). Continue-train from W1.58A8 → W1.58A4 (e.g. 95B+5B tokens). Matches b1.58 quality at same token budget; ~**55%** activated params (7B: 3.4B active); supports **3-bit KV** with negligible avg loss. Enables INT4/FP4 kernels. arXiv:2411.04965. Follow-on: BitNet v2 (arXiv:2504.18415) native 4-bit acts + Hadamard.</data>
      <data key="confidence">0.92</data>
      <data key="status">merged</data>
      <data key="sources">arXiv:2411.04965 | https://arxiv.org/abs/2411.04965 | https://arxiv.org/abs/2504.18415</data>
    </node>
    <node id="paper_bitnet_2b4t">
      <data key="label">BitNet b1.58 2B4T Technical Report (2025)</data>
      <data key="type">Paper</data>
      <data key="summary">Official 2.4B BitNet b1.58 trained 4T tokens (arXiv:2504.12285). Variants: safetensors, bf16, gguf. Primary public checkpoint for bitnet.cpp demos. Prefer this over unofficial PTQ '1-bit' conversions.</data>
      <data key="confidence">0.95</data>
      <data key="status">merged</data>
      <data key="sources">arXiv:2504.12285 | docs/02_SOTA_SURVEY.md | https://hf.co/microsoft/bitnet-b1.58-2B-4T | https://hf.co/microsoft/bitnet-b1.58-2B-4T-gguf | https://arxiv.org/abs/2504.12285</data>
    </node>
    <node id="paper_bitdistill">
      <data key="label">BitNet Distillation / BitDistill (Wu et al. 2025)</data>
      <data key="type">Paper</data>
      <data key="summary">Wu et al. arXiv:2510.13998 — convert off-the-shelf FP LLMs (Qwen3 0.6–4B) to 1.58-bit for **task-specific** finetune without full BitNet pretrain. Three stages: (1) SubLN before MHSA/FFN out-projections; (2) continue-pretrain ~10B Falcon tokens; (3) CE + KL logits distill (τ=5) + MiniLM-style multi-head attention-relation distill (prefer **single late layer**). Naive BitNet-SFT gaps ~13–15 pp and worsen with scale; BitDistill recovers FP16-SFT parity on MNLI/QNLI/SST-2 and CNNDM ROUGE while claiming ~**10×** memory and **~2.65×** CPU tok/s (paper table: 427→1135 tok/s, 1.20→0.11 G). Complementary to GPTQ/AWQ init. Distinct from BitDistiller (arXiv:2402.10631, sub-4-bit self-distill).</data>
      <data key="confidence">0.95</data>
      <data key="status">merged</data>
      <data key="sources">arXiv:2510.13998 | docs/18_DECISION_TREE_AND_COMPLETE_ROADMAP.md | https://arxiv.org/abs/2510.13998 | https://hf.co/papers/2510.13998 | docs/13_TRAINING_QAT_DISTILL.md</data>
    </node>
    <node id="paper_sparse_bitnet">
      <data key="label">Sparse-BitNet (2026)</data>
      <data key="type">Paper</data>
      <data key="summary">Zhang et al. arXiv:2603.05168 — ternary BitNet naturally ~42% zeros; more N:M-friendly than BF16. Sparse-BitLinear: magnitude mask from master weights each step, quant-then-mask, **dual STE** (gradients through masked weights). At 2:4, BF16 +18.8% norm PPL vs BitNet +5.7%; BitNet collapses later under N:8 sweeps. Custom 6:8 sparse TC kernels: up to **~1.30×** e2e on Qwen2.5-3B. Related: Q-Sparse (arXiv:2407.10969). Lab mentions Sparse-BitNet once — add these deltas.</data>
      <data key="confidence">0.9</data>
      <data key="status">merged</data>
      <data key="sources">arXiv:2603.05168 | docs/02_SOTA_SURVEY.md | https://arxiv.org/abs/2603.05168 | https://arxiv.org/abs/2407.10969</data>
    </node>
    <node id="paper_larq_ce">
      <data key="label">Larq Compute Engine (Bannink et al. 2020)</data>
      <data key="type">Paper</data>
      <data key="summary">Fastest open BNN inference engine of its era; ARM BGEMM 8.5–18.5× vs FP on Pixel-class.</data>
      <data key="confidence">0.95</data>
      <data key="status">established</data>
      <data key="sources">arXiv:2011.09398 | docs/02_SOTA_SURVEY.md | docs/16_ECOSYSTEM_AND_TOOLING.md</data>
    </node>
    <node id="paper_finn">
      <data key="label">FINN (Umuroglu et al. FPGA'17)</data>
      <data key="type">Paper</data>
      <data key="summary">Umuroglu et al. streaming heterogeneous dataflow for BNNs on Zynq. Optimizations: XNOR+popcount MVTU; BN+sign→thresholds; maxpool→OR. ZC706 @~200 MHz wall power: **SFC-max MNIST 12.3M FPS**, 0.31 µs latency, Pchip 7.3 W / Pwall 21.2 W → **~583k FPS/W wall** / **~1.69M FPS/W chip**; LFC-max 1.56M FPS; **CNV-max CIFAR-10/SVHN 21.9k FPS**, 283 µs, Pchip 3.6 W / Pwall 11.7 W → **~1.87k FPS/W wall**. Modern FINN: Brevitas→ONNX→FINN IR→HLS/RTL; github.com/Xilinx/finn. Lab docs cite FPS class correctly; add FPS/W and power rails.</data>
      <data key="confidence">0.93</data>
      <data key="status">merged</data>
      <data key="sources">docs/14_HARDWARE_AND_ENERGY.md | docs/16_ECOSYSTEM_AND_TOOLING.md | https://arxiv.org/abs/1612.07119 | https://xilinx.github.io/finn/ | https://github.com/Xilinx/finn</data>
    </node>
    <node id="paper_litespark">
      <data key="label">Litespark Inference (2026)</data>
      <data key="type">Paper</data>
      <data key="summary">SIMD ternary CPU kernels; survey cites ~18× Apple Silicon / extreme x86 vs naive PyTorch — not reproduced in this lab (OpenGap for local numbers).</data>
      <data key="confidence">0.65</data>
      <data key="status">literature</data>
      <data key="sources">arXiv:2605.06485 | docs/02_SOTA_SURVEY.md</data>
    </node>
    <node id="paper_awq">
      <data key="label">AWQ: Activation-aware Weight Quantization</data>
      <data key="type">Paper</data>
      <data key="summary">Production GPU INT4 path for LLMs; default alternative when binary wrap is wrong tool.</data>
      <data key="confidence">0.95</data>
      <data key="status">established</data>
